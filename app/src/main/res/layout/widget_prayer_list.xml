<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card_pill"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- Fajr row -->
    <LinearLayout
        android:id="@+id/row_fajr"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_prayer_highlight"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/icon_fajr"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Fajr"
            android:src="@drawable/ic_prayer_fajr" />

        <TextView
            android:id="@+id/name_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Fajr"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/time_fajr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="05:11"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="2dp" />

    <!-- Dhuhr row -->
    <LinearLayout
        android:id="@+id/row_dhuhr"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/icon_dhuhr"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Dhuhr"
            android:src="@drawable/ic_prayer_dhuhr" />

        <TextView
            android:id="@+id/name_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Dhuhr"
            android:textColor="#8E8E93"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/time_dhuhr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:50"
            android:textColor="#8E8E93"
            android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="2dp" />

    <!-- Asr row -->
    <LinearLayout
        android:id="@+id/row_asr"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/icon_asr"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Asr"
            android:src="@drawable/ic_prayer_asr" />

        <TextView
            android:id="@+id/name_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Asr"
            android:textColor="#8E8E93"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/time_asr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="04:21"
            android:textColor="#8E8E93"
            android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="2dp" />

    <!-- Maghrib row -->
    <LinearLayout
        android:id="@+id/row_maghrib"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/icon_maghrib"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Maghrib"
            android:src="@drawable/ic_prayer_maghrib" />

        <TextView
            android:id="@+id/name_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Maghrib"
            android:textColor="#8E8E93"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/time_maghrib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="07:00"
            android:textColor="#8E8E93"
            android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="2dp" />

    <!-- Isha row -->
    <LinearLayout
        android:id="@+id/row_isha"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/icon_isha"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Isha"
            android:src="@drawable/ic_prayer_isha" />

        <TextView
            android:id="@+id/name_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Isha"
            android:textColor="#8E8E93"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/time_isha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:18"
            android:textColor="#8E8E93"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
